# Public HTTPS base URL of your hosted Express backend (no trailing slash)
VITE_API_URL=https://trivia-happy-hour-api.onrender.com

# Public WSS endpoint of your hosted Express WebSocket server
VITE_WS_URL=wss://trivia-happy-hour-api.onrender.com/ws

# Optional: Canonical public Netlify URL for QR codes & invite links (falls back to window.location.origin)
VITE_PUBLIC_APP_URL=https://trivia-happy-hour.netlify.app
